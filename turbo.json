{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "ALLOW_PUBLIC_REGISTRATION",
        "TURN_SECRET",
        "TURN_DOMAIN",
        "S3_ENDPOINT",
        "S3_BUCKET",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_REGION",
        "S3_PUBLIC_URL",
        "API_URL",
        "API_INTERNAL_URL",
        "SFU_URL",
        "QM_API_INCLUDE_INTEGRATION_TESTS",
        "QM_API_TEST_USE_IN_MEMORY_SERVICES",
        "QM_API_TEST_AUTH_RATE_LIMIT_MAX",
        "QM_API_TEST_REFRESH_RATE_LIMIT_MAX",
        "POSTGRES_PASSWORD",
        "REDIS_PASSWORD"
      ]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
