<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules (cloud backup + device-to-device transfer).
  Auto Backup is disabled at the application level (`android:allowBackup="false"`);
  these rules remain as defense in depth.

  Excludes SharedPreferences files that contain sensitive tokens, and the WebView
  storage under `app_webview/` (IndexedDB with E2EE key material and cached
  plaintext) from both the cloud-backup and device-transfer paths.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="seclettr_push_state.xml" />
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="seclettr_push_state.xml" />
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
