{
  "name": "@seclettr/web",
  "version": "1.4.0-beta",
  "private": true,
  "description": "Seclettr web client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build --mode production",
    "build:diagnostic": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && VITE_APP_DIAGNOSTIC=true vite build --mode diagnostic",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src --ext .ts,.tsx",
    "check:ui-contracts": "node scripts/check-ui-contracts.mjs",
    "check:ui-style": "node scripts/check-ui-style.mjs",
    "android:sync": "vite build --mode production && cap sync android && node scripts/patch-capacitor-plugins.mjs",
    "android:sync:diagnostic": "VITE_APP_DIAGNOSTIC=true vite build --mode diagnostic && cap sync android && node scripts/patch-capacitor-plugins.mjs",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "android:build:debug": "bash ./scripts/build-android-artifacts.sh debug",
    "android:build:diagnostic": "bash ./scripts/build-android-artifacts.sh diagnostic",
    "android:build:release": "bash ./scripts/build-android-artifacts.sh release"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.0",
    "@seclettr/crypto": "workspace:*",
    "@seclettr/protocol": "workspace:*",
    "capacitor-native-biometric": "^4.2.2",
    "libsodium-wrappers-sumo": "0.7.13",
    "mediasoup-client": "^3.7.17",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^26.6.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "@welldone-software/why-did-you-render": "^10",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "license": "Apache-2.0"
}
