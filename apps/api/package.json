{
  "name": "@seclettr/api",
  "version": "1.3.1-beta",
  "private": true,
  "description": "Seclettr API server",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov",
    "test:integration": "QM_API_INCLUDE_INTEGRATION_TESTS=1 vitest run src/test/attachment-access.test.ts src/test/group-history-contract.test.ts src/test/direct-call-signing-sync.test.ts",
    "test:integration:full": "QM_API_INCLUDE_INTEGRATION_TESTS=1 vitest run src/test/auth.test.ts src/test/attachment-access.test.ts src/test/group-history-contract.test.ts src/test/direct-call-signing-sync.test.ts",
    "test:integration:external": "QM_API_INCLUDE_EXTERNAL_SFU_TESTS=1 vitest run src/test/group-call-sfu-bootstrap.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:migrate": "node --import tsx/esm src/db/migrate.ts",
    "db:seed": "node --import tsx/esm src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-presigned-post": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "@seclettr/crypto": "workspace:*",
    "@seclettr/protocol": "workspace:*",
    "argon2": "^0.44.0",
    "fastify": "^4.29.1",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.3.2",
    "nanoid": "^5.1.16",
    "pg": "^8.11.3",
    "web-push": "^3.6.7",
    "ws": "^8.20.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitest/coverage-v8": "1.6.1",
    "eslint": "8.57.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "license": "Apache-2.0"
}
