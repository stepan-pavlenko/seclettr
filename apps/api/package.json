{
  "name": "@seclettr/api",
  "version": "1.4.0-beta",
  "private": true,
  "description": "Seclettr API server",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov",
    "test:integration": "QM_API_INCLUDE_INTEGRATION_TESTS=1 vitest run src/test/attachment-access.test.ts src/test/group-history-contract.test.ts src/test/direct-call-signing-sync.test.ts src/test/refresh-rotation.integration.test.ts src/test/devices.integration.test.ts src/test/calls.integration.test.ts src/test/groups-membership.integration.test.ts src/test/auth-attachment-deny.integration.test.ts src/test/call-route-rate-limit.integration.test.ts",
    "test:integration:full": "QM_API_INCLUDE_INTEGRATION_TESTS=1 vitest run src/test/auth.test.ts src/test/attachment-access.test.ts src/test/group-history-contract.test.ts src/test/direct-call-signing-sync.test.ts src/test/devices.integration.test.ts src/test/calls.integration.test.ts src/test/groups-membership.integration.test.ts src/test/auth-attachment-deny.integration.test.ts src/test/call-route-rate-limit.integration.test.ts",
    "test:integration:external": "QM_API_INCLUDE_EXTERNAL_SFU_TESTS=1 vitest run src/test/group-call-sfu-bootstrap.test.ts",
    "test:integration:crlimit": "QM_API_INCLUDE_INTEGRATION_TESTS=1 QM_API_TEST_CALL_ROUTE_RATE_LIMIT_MAX=3 vitest run src/test/call-route-rate-limit.integration.test.ts",
    "test:integration:authlimit": "QM_API_INCLUDE_INTEGRATION_TESTS=1 QM_API_TEST_AUTH_RATE_LIMIT_MAX=3 vitest run src/test/auth-route-rate-limit.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:migrate": "node --import tsx/esm src/db/migrate.ts",
    "db:seed": "node --import tsx/esm src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-presigned-post": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "@seclettr/crypto": "workspace:*",
    "@seclettr/protocol": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.5.0",
    "ioredis": "^6.0.0",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitest/coverage-v8": "1.6.1",
    "eslint": "8.57.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "license": "Apache-2.0"
}
