{
  "name": "@seclettr/sfu",
  "version": "1.4.0-beta",
  "private": true,
  "description": "Seclettr SFU (mediasoup-based)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "8.0.1",
    "@fastify/websocket": "^10.0.1",
    "@seclettr/protocol": "workspace:*",
    "fastify": "^4.29.1",
    "mediasoup": "^3.20.6",
    "nanoid": "^5.1.16",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "Apache-2.0"
}
