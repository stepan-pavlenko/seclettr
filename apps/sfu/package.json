{
  "name": "@seclettr/sfu",
  "version": "1.3.1-beta",
  "private": true,
  "description": "Seclettr SFU (mediasoup-based)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "8.0.1",
    "@fastify/websocket": "^10.0.1",
    "@seclettr/protocol": "workspace:*",
    "fastify": "^4.29.1",
    "mediasoup": "^3.13.18",
    "nanoid": "^5.1.16",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitest/coverage-v8": "1.6.1",
    "eslint": "8.57.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "license": "Apache-2.0"
}
