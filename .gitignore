# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
artifacts/

# Vite
.vite/

# Environment variables — NEVER commit
.env
.env.local
.env.*.local
infra/.env
infra/.env.dev
infra/.env.test
infra/.env.sandbox

# Logs, docs and other non-source artifacts
docs/
logs/
.vscode
.idea
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage and Playwright
coverage/
playwright-report/
test-results/

# OS artifacts
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp
.sonarlint/
.scannerwork/

# Turbo cache
.turbo/

# Docker volumes (if accidentally created locally)
postgres_data/
minio_data/
coturn_logs/

# TLS certificates generated locally
infra/nginx/certs/*.pem
infra/nginx/certs/*.key
infra/nginx/certs/*.crt

# Dev certificates — never commit keys
infra/.dev-certs/

# Archive artifacts — never commit
*.zip
sonar-export-*/
sonar-export-*.tar.gz

# npm lockfile — project uses pnpm exclusively
package-lock.json

# Other
.runtime
/artifacts
.runlogs

# TypeScript incremental metadata
*.tsbuildinfo

# Guardrail: transpiled JS should never be committed inside TS source tree
apps/web/src/**/*.js

# Capacitor Android — Gradle build cache and local machine config
apps/web/android/.gradle/
apps/web/android/local.properties
apps/web/android/app/build/

# Android Eclipse / ADT metadata
apps/web/android/.project
apps/web/android/.settings/
apps/web/android/app/.classpath
apps/web/android/app/.project
apps/web/android/app/.settings/

# Debug APK bundled for local testing
apps/web/public/seclettr-debug.apk

# Firebase config — contains API keys, never commit
apps/web/android/app/google-services.json
