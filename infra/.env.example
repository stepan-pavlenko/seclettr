# Seclettr environment template
# Copy to infra/.env and replace all CHANGE_ME values before production use.
# Do not commit real secrets.

NODE_ENV=production
HOST=0.0.0.0
PORT=3001
# Proxy trust policy for Fastify request.ip parsing (API + SFU).
# Keep the default unless you explicitly operate behind additional trusted hops.
TRUST_PROXY="loopback, linklocal, uniquelocal"

# Database
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT (minimum 32 characters)
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS

# Registration policy (true/false)
ALLOW_PUBLIC_REGISTRATION=true

# Cookie security (true in production; set to false only for HTTP-only local dev)
COOKIE_SECURE=true

# TURN
TURN_SECRET=CHANGE_ME_TURN_SECRET
TURN_DOMAIN=localhost
TURN_EXTERNAL_IP=127.0.0.1
TURN_MIN_PORT=50000
TURN_MAX_PORT=51999

# MinIO / S3
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
# Storage images. Upstream minio/minio and minio/mc were removed from Docker
# Hub; the defaults below are pinned, verified-working equivalents. Override
# these if you mirror images internally.
MINIO_IMAGE=bitnamilegacy/minio:2025.7.23-debian-12-r5
MINIO_MC_IMAGE=bitnamilegacy/minio-client:2025.7.21-debian-12-r3

# SFU announced IP (public server IP in production)
ANNOUNCED_IP=127.0.0.1

# CORS origin(s), comma-separated if multiple
CORS_ORIGIN=https://chat.example.com

# Prebuilt image references used by docker-compose.release.yml
# When using GHCR (GitHub Container Registry):
SECLETTR_IMAGE_TAG=latest
SECLETTR_API_IMAGE=ghcr.io/stepan-pavlenko/seclettr/api
SECLETTR_WEB_IMAGE=ghcr.io/stepan-pavlenko/seclettr/web
SECLETTR_SFU_IMAGE=ghcr.io/stepan-pavlenko/seclettr/sfu

# For local/offline builds (images loaded from prebuilt-images.tar.gz):
# SECLETTR_IMAGE_TAG=release
# SECLETTR_API_IMAGE=seclettr/api
# SECLETTR_WEB_IMAGE=seclettr/web
# SECLETTR_SFU_IMAGE=seclettr/sfu

# Nginx config selector
# nginx.conf      -> HTTPS + redirect from HTTP
# nginx.http.conf -> HTTP only
NGINX_CONFIG=nginx.conf

# Release installer defaults (can be overridden via install.sh flags)
# DEPLOY_MODE: full | backend | web
DEPLOY_MODE=full
# NETWORK_MODE: tls | http
NETWORK_MODE=tls

# Web runtime endpoint overrides (used by runtime-config.js)
# Keep /api and /sfu for co-located full-stack deployment.
WEB_RUNTIME_API_URL=/api
WEB_RUNTIME_SFU_URL=/sfu

# Optional local runner values (not used by docker-compose api env block)
DATABASE_URL=postgresql://seclettr:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/seclettr
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379

# S3-compatible object store values for local runners
S3_ENDPOINT=http://localhost:9000
# Browser-facing origin used for MinIO presigned upload/download URLs in release deployments.
# Usually equals CORS_ORIGIN, e.g. https://seclettr.com.
S3_PUBLIC_URL=
S3_BUCKET=seclettr-attachments
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET
S3_REGION=us-east-1

# SFU base URL used by the API container to reach the SFU.
# The SFU container uses host networking, so use the host gateway
# (http://sfu:3002 does not resolve from inside the API container).
SFU_URL=http://host.docker.internal:3002

# Browser-facing SFU URL handed to public room guests (optional).
# Leave empty to use the client's same-origin /sfu proxy (recommended).
# Only set this to an absolute public URL if the SFU is reached by a
# different hostname than the web app.
SFU_PUBLIC_URL=

# Optional Web Push (leave empty to disable)
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
VAPID_SUBJECT=CHANGE_ME_VAPID_SUBJECT

# ── FCM (Firebase Cloud Messaging) for Android native push ──────────────
# Optional — leave empty to use the fallback WebSocket foreground service.
#
# Choose ONE of:
#
# Option A: path to Firebase Admin SDK service account JSON file
#   FCM_SERVICE_ACCOUNT_PATH=/etc/seclettr/firebase-service-account.json
#
# Option B: inline Firebase Admin SDK service account JSON
#   FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# To get the service account key:
#    Firebase Console > Project Settings > Service accounts > Generate new private key
FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVICE_ACCOUNT_JSON=

# Metrics endpoint auth (required in production — minimum 16 characters)
METRICS_BEARER_TOKEN=CHANGE_ME_METRICS_BEARER_TOKEN

# JWT token lifetimes
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Message size limit in bytes (default: 12 MiB)
MAX_MESSAGE_JSON_BYTES=12582912

# Attachment size limit in bytes (default: 100 MiB)
MAX_ATTACHMENT_BYTES=104857600

# Retention policy in days (defaults shown)
DELIVERED_MESSAGE_RETENTION_DAYS=30
UNDELIVERED_MESSAGE_RETENTION_DAYS=90
GROUP_MESSAGE_RETENTION_DAYS=30
ENDED_CALL_SESSION_RETENTION_DAYS=30
